server {
    listen 80;
    server_name localhost;
    return 308 https://localhost:${PRODUCT_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name localhost;
    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 3m;
    resolver 127.0.0.11 valid=5s ipv6=off;

    location /api/ {
        set $business_upstream business:8080;
        proxy_pass http://$business_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:${PRODUCT_HTTPS_PORT};
        proxy_set_header X-Forwarded-Host localhost:${PRODUCT_HTTPS_PORT};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port ${PRODUCT_HTTPS_PORT};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 120s;
    }

    location / {
        set $web_upstream web:3000;
        proxy_pass http://$web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:${PRODUCT_HTTPS_PORT};
        proxy_set_header X-Forwarded-Host localhost:${PRODUCT_HTTPS_PORT};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port ${PRODUCT_HTTPS_PORT};
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
    }
}
